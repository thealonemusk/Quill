# Quill configuration template. Copy to config/.env and fill in.
# config/.env is gitignored; this file is tracked and must only ever hold
# placeholders.

# ── Resume tailoring (pick one provider) ─────────────────────────────────────
# LLM_PROVIDER=gemini uses GEMINI_API_KEY / GEMINI_MODEL; blank uses gpt_key.
LLM_PROVIDER=
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
gpt_key=your_openai_key_here
OPENAI_MODEL=
OPENAI_BASE_URL=

# ── Job-site logins (read only by the scanners) ──────────────────────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=
INSTAHYRE_EMAIL=
INSTAHYRE_PASSWORD=
# Default Workday login; per-tenant ones go through scripts/workday_login.py.
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# ── Search preferences ───────────────────────────────────────────────────────
TARGET_ROLES=Software Engineer,Backend Engineer
EXPERIENCE_YEARS=2
PREFERRED_LOCATIONS=Bengaluru,Remote
# india or europe. Europe searches the UK, Ireland, Germany, and the Netherlands.
TARGET_REGION=india
MIN_RELEVANCE_SCORE=55
EXCLUDED_COMPANIES=

# ── Server ───────────────────────────────────────────────────────────────────
# Keep 127.0.0.1. 0.0.0.0 serves your profile, resume and every write endpoint
# to anything on the same network, with no login.
API_HOST=127.0.0.1
API_PORT=8000
# Optional: pin the extension allowed to call the API (id from chrome://extensions).
EXTENSION_ID=
